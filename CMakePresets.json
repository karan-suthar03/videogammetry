{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (MSVC)",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/windows",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-static",
      "displayName": "Windows (MSVC), self-contained exes",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/build/windows-static",
      "cacheVariables": { "VG_STATIC": "ON" }
    },
    {
      "name": "linux",
      "displayName": "Linux (Ninja)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/linux",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "windows-release", "configurePreset": "windows", "configuration": "Release" },
    { "name": "windows-debug",   "configurePreset": "windows", "configuration": "Debug" },
    { "name": "windows-static-release", "configurePreset": "windows-static", "configuration": "Release" },
    { "name": "linux-release",   "configurePreset": "linux",   "configuration": "Release" },
    { "name": "linux-debug",     "configurePreset": "linux",   "configuration": "Debug" }
  ]
}
