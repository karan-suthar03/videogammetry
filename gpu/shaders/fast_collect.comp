#version 450
// Appends a level's FAST candidates (main threshold, or the retry threshold
// in cells where the main one found nothing) with their Harris response, and
// writes the response into the level's score map for non-maximum suppression.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 16, local_size_y = 16) in;
#include "common.glsl"
#include "fast.glsl"

layout(push_constant) uniform P { int lv; } pc;

void main() {
    const int x = level(pc.lv, kLvX0) + int(gl_GlobalInvocationID.x);
    const int y = level(pc.lv, kLvY0) + int(gl_GlobalInvocationID.y);
    if (x >= level(pc.lv, kLvX1) || y >= level(pc.lv, kLvY1)) return;
    const int off = level(pc.lv, kLvImage), stride = level(pc.lv, kLvStride);
    const int cell = level(pc.lv, kLvCell);
    const int c = ((y - level(pc.lv, kLvY0)) / cell) * level(pc.lv, kLvCols) + (x - level(pc.lv, kLvX0)) / cell;
    const bool cellMain = cellHasMain[level(pc.lv, kLvCells) + c] != 0u;
    const int t = cellMain ? level(pc.lv, kLvThreshold) : level(pc.lv, kLvMinThreshold);
    if (!isFastCorner(off, stride, x, y, t)) return;

    const float score = harrisResponse(off, stride, x, y);
    scoreMap[level(pc.lv, kLvScore) + y * level(pc.lv, kLvWidth) + x] = score;
    const uint i = atomicAdd(res[kResCandidates], 1u);
    if (i >= uint(params[kParamCandidateCapacity])) return;  // overflow: the host retries with more room
    cand[3u * i] = uint(x) | (uint(y) << 16);
    cand[3u * i + 1u] = uint(pc.lv);
    cand[3u * i + 2u] = floatBitsToUint(score);
}
